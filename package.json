{
  "name": "@ejqs/better-auth-prisma8",
  "version": "0.1.0",
  "description": "A native Better Auth database adapter for the Prisma 8 contract-based ORM.",
  "type": "module",
  "license": "MIT",
  "author": "ejqs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejqs/better-auth-prisma8.git"
  },
  "homepage": "https://github.com/ejqs/better-auth-prisma8#readme",
  "bugs": {
    "url": "https://github.com/ejqs/better-auth-prisma8/issues"
  },
  "keywords": [
    "better-auth",
    "prisma",
    "prisma-8",
    "adapter",
    "authentication"
  ],
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "better-auth-prisma8": "./bin/better-auth-prisma8.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "import": "./dist/generator/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build && npm run check && npm test"
  },
  "peerDependencies": {
    "@prisma-next/postgres": ">=0.16.0 <1",
    "better-auth": ">=1.7.1 <2"
  },
  "dependencies": {
    "@prisma-next/sql-orm-client": "^0.16.0"
  },
  "devDependencies": {
    "@prisma-next/postgres": "0.16.0",
    "@prisma-next/sql-orm-client": "0.16.0",
    "@types/node": "^24.0.0",
    "better-auth": "1.7.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
